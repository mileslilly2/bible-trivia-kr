// ===============================
// Base extracted facts
// ===============================

.decl parent_of(parent:symbol, child:symbol)
.decl spoke_to(speaker:symbol, listener:symbol)
.decl parent_gender(parent:symbol, gender:symbol)
.decl renamed_to(ref:symbol, name:symbol)

.decl killed(killer:symbol, victim:symbol)

.decl traveled_to(traveler:symbol, destination:symbol)
.decl traveled_from_to(traveler:symbol, source:symbol, destination:symbol)

.decl role(person:symbol, role:symbol)
.decl reign_realm(person:symbol, realm:symbol)

.decl appeared_to(entity:symbol, recipient:symbol)
.decl manifestation(entity:symbol, form:symbol)

// provenance metadata (generated by pipeline)
.decl fact_ref(kind:symbol, a:symbol, b:symbol, ref:symbol)


// ===============================
// Genealogy inference
// ===============================

.decl begat(father:symbol, child:symbol)
.decl father(father:symbol, child:symbol)
.decl ancestor_of(ancestor:symbol, descendant:symbol)
.decl descendant_of(descendant:symbol, ancestor:symbol)
.decl sibling(person1:symbol, person2:symbol)


// ===============================
// Event model
// ===============================

.decl event(eid:symbol)
.decl event_type(eid:symbol, t:symbol)
.decl agent(eid:symbol, a:symbol)
.decl recipient(eid:symbol, r:symbol)
.decl participant(person:symbol, event:symbol)
.decl travel_path(start:symbol, end:symbol)


// ===============================
// Dialogue inference
// ===============================

.decl said(speaker:symbol, listener:symbol, message:symbol)
.decl interacted_with(a:symbol, b:symbol)
.decl indirect_dialogue(a:symbol, b:symbol)


// ===============================
// Outputs
// ===============================

.output begat
.output father
.output ancestor_of
.output descendant_of
.output sibling

.output event
.output event_type
.output agent
.output recipient
.output participant
.output travel_path

.output said
.output interacted_with
.output indirect_dialogue
.output fact_ref
